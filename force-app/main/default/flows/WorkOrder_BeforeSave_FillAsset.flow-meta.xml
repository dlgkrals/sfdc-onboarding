<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copy_From_Case</name>
        <label>비어 있는 값만 접수에서 복사</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.AssetId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxAssetId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxAccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.CustomerSite__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxSiteId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ServiceCenter__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxServiceCenter</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.VisitFee__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxVisitFee</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description
  >26-10-16 출동 저장 전(안전망): 장비·고객사·사업장·서비스센터가 비어 있고 접수가 있으면 접수의 값을 복사(이미 있으면 그대로). 출장비가 비면 ServiceSetting VisitFee(실습 중 발견한 빈 출장비 결함). 서비스센터가 비면 센터장 공유 규칙이 걸리지 않음. 주 경로는 접수 [기사 배정](DispatchService가 같은 값을 채움) by Edwin</description>
    <environments>Default</environments>
    <formulas>
        <name>fxVisitFee</name>
        <dataType>Currency</dataType>
        <expression
    >IF(ISBLANK({!$Record.VisitFee__c}), {!Get_VisitFee.Value__c}, {!$Record.VisitFee__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxAssetId</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK({!$Record.AssetId}), {!$Record.Case.AssetId}, {!$Record.AssetId})</expression>
    </formulas>
    <formulas>
        <name>fxAccountId</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK({!$Record.AccountId}), {!$Record.Case.AccountId}, {!$Record.AccountId})</expression>
    </formulas>
    <formulas>
        <name>fxSiteId</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK({!$Record.CustomerSite__c}), {!$Record.Case.CustomerSite__c}, {!$Record.CustomerSite__c})</expression>
    </formulas>
    <formulas>
        <name>fxServiceCenter</name>
        <dataType>String</dataType>
        <expression
    >IF(ISBLANK(TEXT({!$Record.ServiceCenter__c})), TEXT({!$Record.Case.ServiceCenter__c}), TEXT({!$Record.ServiceCenter__c}))</expression>
    </formulas>
    <interviewLabel
  >출동 접수 정보 채우기 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>출동 저장 전 - 접수 정보 채우기</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_VisitFee</name>
        <label>출장비 기준값</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copy_From_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>VisitFee</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ServiceSetting__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Value__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_VisitFee</targetReference>
        </connector>
        <filterFormula
    >AND(NOT(ISBLANK({!$Record.CaseId})), OR(ISBLANK({!$Record.VisitFee__c}), ISBLANK({!$Record.AssetId}), ISBLANK({!$Record.AccountId}), ISBLANK({!$Record.CustomerSite__c}), ISBLANK(TEXT({!$Record.ServiceCenter__c}))))</filterFormula>
        <object>WorkOrder</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
