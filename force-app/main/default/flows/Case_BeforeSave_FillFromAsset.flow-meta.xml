<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Assign_FromSite</name>
        <label>고객사·사업장·서비스센터 복사</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Asset.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.CustomerSite__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Site.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ServiceCenter__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Site.ServiceCenter__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Urgent_Site</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Urgent</name>
        <label>긴급도 = 긴급</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Urgent</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Site</name>
        <label>사업장이 있는 장비인가</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>사업장 없음(출하 상태) - 복사 안 함</defaultConnectorLabel>
        <rules>
            <name>Site_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Asset.CustomerSite__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Site</targetReference>
            </connector>
            <label>사업장 있음</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Urgent_Site</name>
        <label>긴급 용도 사업장인가</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>일반 용도</defaultConnectorLabel>
        <rules>
            <name>Urgent_Usage</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Site.UsageType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ColdStorage</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Site.UsageType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ServerRoom</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Urgent</targetReference>
            </connector>
            <label>냉동창고·서버실</label>
        </rules>
    </decisions>
    <description>26-10-06 장비의 고객사·사업장·서비스센터를 접수에 복사하고 냉동창고·서버실이면 긴급으로 지정 by Edwin</description>
    <environments>Default</environments>
    <interviewLabel>접수 자동 채우기(저장 전) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>접수 자동 채우기(저장 전)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Asset</name>
        <label>장비 가져오기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Site</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>CustomerSite__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Site</name>
        <label>사업장 가져오기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_FromSite</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Asset.CustomerSite__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomerSite__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ServiceCenter__c</queriedFields>
        <queriedFields>UsageType__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Asset</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.AssetId})), OR(ISNEW(), ISCHANGED({!$Record.AssetId})))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
