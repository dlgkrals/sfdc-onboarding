    <description
  >26-10-15 출동 승인 요청: 사유·고객 동의 저장 → 승인 프로세스 HG_WorkOrderApproval 제출. 진입 조건 판단은 승인 프로세스. 실패 시 저장 되돌림은 호출한 화면 Flow가 Roll Back Records로(자동 실행 Flow는 롤백 요소 불가). / 26-10-16 제출 코멘트 = 승인 요청 요약(승인 필요 이유·부품별 줄·사유·고객 동의·메모, 기준값 ServiceSetting ApprovalAmount, 승인 코멘트 한도 4000자 → 3900자에서 자름), 같은 요약을 출동 ApprovalSummary__c에 저장(메일 템플릿용). 선택 입력 submitterId(관리자가 소유 기사 이름으로 제출할 때, 비우면 실행 사용자). 화면 WorkOrder_Screen_RequestApproval이 호출, Apex 테스트 WorkOrderApprovalFlowTest by Edwin</description>
    <environments>Default</environments>
    <formulas>
        <name>fxComment</name>
        <dataType>String</dataType>
        <expression
    >IF(LEN({!varSummary}) &gt; 3900, LEFT({!varSummary}, 3900) &amp; &quot;…(이하 생략)&quot;, {!varSummary})</expression>
    </formulas>
    <formulas>
        <name>fxConsent</name>
        <dataType>String</dataType>
        <expression
    >IF({!customerConsent}, &quot;예&quot;, &quot;아니오&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxNeedReason</name>
        <dataType>String</dataType>
        <expression
    >IF(BLANKVALUE({!Get_WorkOrder.ruExceptionFreeCount__c}, 0) &gt; 0, &quot;예외 무상 &quot; &amp; TEXT(BLANKVALUE({!Get_WorkOrder.ruExceptionFreeCount__c}, 0)) &amp; &quot;건&quot;, &quot;&quot;) &amp; IF(AND(BLANKVALUE({!Get_WorkOrder.ruExceptionFreeCount__c}, 0) &gt; 0, BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0) &gt; BLANKVALUE({!Get_Threshold.Value__c}, 500000)), &quot; / &quot;, &quot;&quot;) &amp; IF(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0) &gt; BLANKVALUE({!Get_Threshold.Value__c}, 500000), &quot;청구 ₩&quot; &amp; {!fxTotalText} &amp; &quot; (기준 ₩&quot; &amp; {!fxThresholdText} &amp; &quot; 초과)&quot;, IF(BLANKVALUE({!Get_WorkOrder.ruExceptionFreeCount__c}, 0) &gt; 0, &quot;&quot;, &quot;청구 ₩&quot; &amp; {!fxTotalText} &amp; &quot; (기준 ₩&quot; &amp; {!fxThresholdText} &amp; &quot; 이하)&quot;))</expression>
    </formulas>
    <formulas>
        <name>fxPartAmountText</name>
        <dataType>String</dataType>
        <expression
    >IF(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0)/1000000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(FLOOR(MOD(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0),1000000)/1000)), 3) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(MOD(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0),1000)), 3), IF(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0)/1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(MOD(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0),1000)), 3), TEXT(ROUND(BLANKVALUE({!Loop_Parts.fmAmount__c}, 0),0))))</expression>
    </formulas>
    <formulas>
        <name>fxPartLine</name>
        <dataType>String</dataType>
        <expression
    >&quot;[부품] &quot; &amp; {!Loop_Parts.ProductName} &amp; &quot; ×&quot; &amp; TEXT({!Loop_Parts.QuantityConsumed}) &amp; &quot; &quot; &amp; IF(TEXT({!Loop_Parts.ChargeType__c}) = &quot;Paid&quot;, &quot;유상&quot;, &quot;무상&quot;) &amp; &quot; ₩&quot; &amp; {!fxPartAmountText}</expression>
    </formulas>
    <formulas>
        <name>fxThresholdText</name>
        <dataType>String</dataType>
        <expression
    >IF(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0)/1000000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(FLOOR(MOD(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0),1000000)/1000)), 3) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(MOD(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0),1000)), 3), IF(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0)/1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(MOD(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0),1000)), 3), TEXT(ROUND(BLANKVALUE({!Get_Threshold.Value__c}, 500000),0))))</expression>
    </formulas>
    <formulas>
        <name>fxTotalText</name>
        <dataType>String</dataType>
        <expression
    >IF(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0)/1000000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(FLOOR(MOD(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0),1000000)/1000)), 3) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(MOD(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0),1000)), 3), IF(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0)/1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT(MOD(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0),1000)), 3), TEXT(ROUND(BLANKVALUE({!Get_WorkOrder.fmTotalCharge__c}, 0),0))))</expression>
    </formulas>
