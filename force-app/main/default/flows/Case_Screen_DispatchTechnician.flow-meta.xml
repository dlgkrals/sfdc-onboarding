        <fields>
            <name>MsgCaseSummary</name>
            <fieldText
      >&lt;p&gt;&lt;strong&gt;접수 {!varCaseNumber}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;장비: {!varAssetName}&lt;/p&gt;&lt;p&gt;사업장: {!varSiteName}&lt;/p&gt;&lt;p&gt;증상: {!varSymptom} · 중요도: {!varPriority}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>MsgExistingWorkOrders</name>
            <fieldText
      >&lt;p&gt;&lt;span style=&quot;color: rgb(186, 5, 23);&quot;&gt;이 접수에는 이미 출동 {!varWorkOrderCount}건이 있습니다. 배정하면 새 출동이 하나 더 만들어집니다(재방문·재배정).&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>varWorkOrderCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>TechnicianInput</name>
            <choiceReferences>TechnicianChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>기사</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText
      >&lt;p&gt;우리 센터 기사만 보입니다(역할 계층 기준, 서비스운영팀장은 전체).&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>PurposeInput</name>
            <choiceReferences>PurposeChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>출동 목적</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>PlannedStartInput</name>
            <dataType>DateTime</dataType>
            <fieldText>방문 예정 일시</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>InstructionInput</name>
            <fieldText>작업 지시</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>배정</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
