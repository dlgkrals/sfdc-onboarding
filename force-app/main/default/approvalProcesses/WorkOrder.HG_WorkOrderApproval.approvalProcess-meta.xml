<?xml version="1.0" encoding="UTF-8" ?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>fmSiteName__c</field>
        <field>fmTotalCharge__c</field>
        <field>HasExceptionFree__c</field>
        <field>CustomerConsent__c</field>
        <field>ApprovalRequestReason__c</field>
        <field>ApprovalRejectReason__c</field>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>센터장 승인</label>
        <name>CenterManagerApproval</name>
    </approvalStep>
    <description
  >26-10-07 예외 무상 또는 총 청구액 50만 원 초과 출동을 센터장이 승인 by Edwin</description>
    <emailTemplate>unfiled$public/HG_WO_ApprovalRequest</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(
  ISPICKVAL(Status, &apos;Arrived&apos;),
  NOT(ISBLANK(ApprovalRequestReason__c)),
  OR(
    HasExceptionFree__c,
    fmTotalCharge__c &gt; 500000
  ),
  OR(
    fmTotalCharge__c &lt;= 500000,
    CustomerConsent__c
  )
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>HG_WO_Approval_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>HG_WO_ApprovalResultToOwner</name>
            <type>Alert</type>
        </action>
        <action>
            <name>HG_WO_Status_Arrived</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>HG_WO_Approval_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>HG_WO_ApprovalResultToOwner</name>
            <type>Alert</type>
        </action>
        <action>
            <name>HG_WO_Status_Arrived</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>HG_WO_Approval_Pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>HG_WO_Status_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>출동 승인 (예외 무상·고액 유상)</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>HG_WO_Approval_Recalled</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>HG_WO_Status_Arrived</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
