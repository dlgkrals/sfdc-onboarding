<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Complete_RequiresArrival</fullName>
    <active>true</active>
    <description>26-10-07 도착 없이 완료 불가 by Edwin</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Status, &apos;Completed&apos;),
  ISBLANK(ArrivalDateTime__c)
)</errorConditionFormula>
    <errorDisplayField>ArrivalDateTime__c</errorDisplayField>
    <errorMessage>도착 일시를 먼저 기록해야 완료할 수 있습니다.</errorMessage>
</ValidationRule>
