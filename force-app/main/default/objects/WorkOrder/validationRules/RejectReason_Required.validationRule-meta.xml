<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RejectReason_Required</fullName>
    <active>true</active>
    <description>26-10-07 반려 사유 없이 반려 by Edwin</description>
    <errorConditionFormula>AND(
  ISCHANGED(ApprovalStatus__c),
  ISPICKVAL(ApprovalStatus__c, &apos;Rejected&apos;),
  ISBLANK(ApprovalRejectReason__c)
)</errorConditionFormula>
    <errorDisplayField>ApprovalRejectReason__c</errorDisplayField>
    <errorMessage>반려하려면 반려 사유를 먼저 입력하세요.</errorMessage>
</ValidationRule>
