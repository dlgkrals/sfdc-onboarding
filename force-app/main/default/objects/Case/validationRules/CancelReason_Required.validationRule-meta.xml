<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CancelReason_Required</fullName>
    <active>true</active>
    <description>26-10-07 취소 사유 필수 by Edwin</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Status, &apos;Canceled&apos;),
  ISBLANK(CancelReason__c)
)</errorConditionFormula>
    <errorDisplayField>CancelReason__c</errorDisplayField>
    <errorMessage>접수를 취소하려면 취소 사유를 입력하세요.</errorMessage>
</ValidationRule>
