<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BillingContactEmail_Required</fullName>
    <active>true</active>
    <description>26-10-07 청구 담당자 이메일 필수 by Edwin</description>
    <errorConditionFormula>AND(
  RecordType.DeveloperName &lt;&gt; &apos;Individual&apos;,
  ISBLANK(BillingContactEmail__c)
)</errorConditionFormula>
    <errorDisplayField>BillingContactEmail__c</errorDisplayField>
    <errorMessage
  >청구 담당자 이메일을 입력하세요. 세금계산서 발송에 필요합니다.</errorMessage>
</ValidationRule>
