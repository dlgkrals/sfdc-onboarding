<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Site_AccountMatch</fullName>
    <active>true</active>
    <description>26-10-07 장비·사업장 고객사 일치 by Edwin</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(CustomerSite__c)),
  CustomerSite__r.Account__c &lt;&gt; AccountId
)</errorConditionFormula>
    <errorDisplayField>CustomerSite__c</errorDisplayField>
    <errorMessage
  >설치 사업장이 장비의 고객사 소속이 아닙니다. 고객사 또는 사업장을 확인하세요.</errorMessage>
</ValidationRule>
