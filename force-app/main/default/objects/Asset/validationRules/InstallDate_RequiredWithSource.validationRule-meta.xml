<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>InstallDate_RequiredWithSource</fullName>
    <active>true</active>
    <description>26-10-07 근거 있으면 설치일 필수 by Edwin</description>
    <errorConditionFormula>AND(
  NOT(ISPICKVAL(InstallationDateSource__c, &apos;Unverified&apos;)),
  ISBLANK(InstallDate)
)</errorConditionFormula>
    <errorDisplayField>InstallDate</errorDisplayField>
    <errorMessage>설치일 근거를 선택했다면 설치일을 입력하세요.</errorMessage>
</ValidationRule>
