<!--
  @description 고객사 "새로 만들기"(데스크톱) 재정의용 Aura 래퍼 — 실제 화면은 LWC accountNew
               · 표준 레코드 유형 선택 화면에서 고른 유형이 state.recordTypeId로 들어옴 → recordTypeId
               · 재정의 화면 캐시 대응: pageReference가 바뀔 때마다 LWC를 지웠다가 다시 그림 (customerSiteNewOverride와 같음)
  @layer       Aura (재정의 래퍼)
  @author      Edwin
  @date        2026-10-14
  변경 이력: 1.1 2026-10-14 새로 만들기마다 화면 초기화(캐시된 입력값이 남던 결함)
  @see         accountNew (LWC), docs/decision-log.md (재정의·되돌리기·캐시)
-->
<aura:component
  implements="lightning:actionOverride,lightning:isUrlAddressable"
  access="global"
>
  <aura:attribute name="recordTypeId" type="String" />
  <aura:attribute name="showForm" type="Boolean" default="true" />
  <aura:handler name="init" value="{!this}" action="{!c.readState}" />
  <aura:handler
    name="change"
    value="{!v.pageReference}"
    action="{!c.readState}"
  />
  <aura:if isTrue="{!v.showForm}">
    <c:accountNew recordTypeId="{!v.recordTypeId}" />
  </aura:if>
</aura:component>
