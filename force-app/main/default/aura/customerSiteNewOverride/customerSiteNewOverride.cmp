<!--
  @description 사업장 "새로 만들기"(데스크톱) 재정의용 Aura 래퍼 — 표준 버튼 재정의에는 lightning:actionOverride를 구현한
               Aura 컴포넌트만 고를 수 있어, 실제 화면은 LWC customerSiteNew에 맡기고 여기서는 주소 상태만 넘김
               · 관련 목록(고객사 → 사업장)에서 열면 state.inContextOfRef에 부모 고객사가 들어옴 → parentAccountId
               · 재정의 화면은 캐시되어 다시 쓰임(공식 문서: 같은 컴포넌트로 이동하면 다시 만들지 않고 pageReference만 바꿀 수 있음)
                 → pageReference가 바뀔 때마다 LWC를 지웠다가 다시 그려 입력값·주소·센터·오류를 처음 상태로
  @layer       Aura (재정의 래퍼)
  @author      Edwin
  @date        2026-10-14
  변경 이력: 1.1 2026-10-14 새로 만들기마다 화면 초기화(캐시된 입력값이 남던 결함)
  @see         customerSiteNew (LWC), docs/decision-log.md (재정의·되돌리기·캐시)
-->
<aura:component
  implements="lightning:actionOverride,lightning:isUrlAddressable"
  access="global"
>
  <aura:attribute name="parentAccountId" type="String" />
  <aura:attribute name="showForm" type="Boolean" default="true" />
  <aura:handler name="init" value="{!this}" action="{!c.readState}" />
  <!-- DESC: 재정의 화면은 재사용(캐시)되므로 주소(pageReference)가 바뀔 때마다 다시 읽고 화면을 새로 그림 -->
  <aura:handler
    name="change"
    value="{!v.pageReference}"
    action="{!c.readState}"
  />
  <aura:if isTrue="{!v.showForm}">
    <c:customerSiteNew parentAccountId="{!v.parentAccountId}" />
  </aura:if>
</aura:component>
